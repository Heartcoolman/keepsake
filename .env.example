# xAI API key (https://console.x.ai) — required unless MOCK_AI=1
XAI_API_KEY=
# Optional OpenAI-compatible local gateway. When set, XAI_API_KEY may be empty.
AI_BASE_URL=
# Optional model name for the configured gateway.
AI_MODEL=
# Server port
PORT=8787
# Set to 1 to serve canned AI responses with zero API cost
MOCK_AI=0
# HMAC secret for /api/v1 JWT (min 16 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Local development only: allow an in-memory key when JWT_SECRET is unset.
# Never enable in production; docker-compose requires JWT_SECRET.
ALLOW_EPHEMERAL_JWT=0
# Optional shared secret for POST /api/v1/auth/bootstrap
# (header X-Bootstrap-Token or body.bootstrapToken). Recommended when :8787 is
# reachable before the first account exists (LAN / tunnel).
BOOTSTRAP_TOKEN=
# Optional gate for open registration (POST /api/v1/auth/register, header
# X-Registration-Code or body.regCode). Leave empty for open signup.
# NOTE: once the /ops console writes data/ops-config.json, that file replaces
# this variable entirely (including "no code required").
REGISTRATION_CODE=
# One-time token for creating the FIRST operator of the /ops console
# (POST /api/ops/auth/bootstrap). Only honored while zero operators exist —
# set it, bootstrap at /ops, then remove it. See docs/ops.md.
OPS_BOOTSTRAP_TOKEN=
# Number of trusted reverse-proxy hops in front of the server. 0 = ignore
# X-Forwarded-For/Proto (direct exposure). Set to the count of proxies that each
# append one entry (1 for a single proxy/tunnel); the client IP/proto is then read
# that many entries from the right, so client-spoofed leftmost entries are ignored.
# IMPORTANT: leaving this at 0 behind a TLS-terminating proxy also means the
# refresh cookie is issued WITHOUT the Secure flag — the server logs a warning
# when it sees X-Forwarded-Proto it is not allowed to trust.
TRUST_PROXY=0
# Force the refresh cookie's Secure flag: 1 = always, 0 = never, empty = detect
# from the request (honouring TRUST_PROXY). Set to 1 when clients always reach
# the app over HTTPS but TRUST_PROXY cannot be used.
COOKIE_SECURE=
# Per-job timeout for the serialized image-inference queue, in ms (default 120000).
# Bounds how long one wedged ONNX call can block everything queued behind it.
INFERENCE_TIMEOUT_MS=
# Timezone used to render date labels on share cards and annual books. The
# container clock is UTC; leaving this unset makes memories shot before 08:00
# (UTC+8) carry a date one day earlier than the App shows. Default Asia/Shanghai.
APP_TZ=Asia/Shanghai
# Authorization token. Without a valid token the server degrades to demo mode
# (equivalent to MOCK_AI=1 + INFERENCE_DISABLED=1). Lookup order:
# NIANXIANG_LICENSE (token body) -> NIANXIANG_LICENSE_FILE (path) ->
# ./nianxiang.license or ../nianxiang.license.
NIANXIANG_LICENSE=
NIANXIANG_LICENSE_FILE=
# Set to 1 to broadcast depth/face inference as unavailable and skip every ONNX
# path. Demo mode sets this on its own; set it by hand only to run without models.
INFERENCE_DISABLED=0
# Optional OpenVINO iGPU sidecars. Empty = local CPU ONNX. Both are probed at
# /healthz and fall back silently on failure, so an unset URL costs latency, not
# correctness — check the /ops model tab to see which path is live.
DEPTH_SIDECAR_URL=
MATTING_SIDECAR_URL=
# Depth sidecar tiling, 1-3 (default 1). ZipDepth runs a full 1024 frame in ~0.2s;
# raising this multiplies cost for detail the particle engine does not consume.
DEPTH_SIDECAR_TILES=1
# In-memory keyring idle eviction, in ms. Floored at 300000 (5 min) so a typo
# cannot make every request re-prompt for the password; default 43200000 (12h).
KEYRING_IDLE_TTL_MS=
# SSE keep-alive interval for GET /entries/changes, in ms (default 25000).
# Lower it only when a proxy in front of the server times idle connections out sooner.
CHANGES_HEARTBEAT_MS=
